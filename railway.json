{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS"
    },
    "deploy": {
        "preDeployCommand": "chmod +x ./railway/pre-deploy.sh && sh ./railway/pre-deploy.sh",
        "healthcheckPath": "/login",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
