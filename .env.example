APP_NAME=Laravel

# Lokaal ontwikkelen:
#   APP_ENV=local, APP_DEBUG=true, APP_URL=http://localhost:8000
# Productie:
#   APP_ENV=production, APP_DEBUG=false, APP_URL=https://<jouw-domein>
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Gebruik 'stderr' in productie (Railway logt naar stderr; file-logging is vluchtig).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Accounts voor UsersSeeder. In productie M&Ugrave;ST SEED_ADMIN_PASSWORD worden
# gezet met een sterk wachtwoord. Lokaal (zonder deze variabelen) wordt een
# willekeurig wachtwoord gegenereerd en in de console getoond.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_USER_EMAIL=testaccount01@example.com
# SEED_USER_PASSWORD=

# Alleen op de EERSTE deploy op true zetten om de admin-account aan te maken.
# Daarna uitzetten (of weglaten) zodat er nooit meer geseed wordt. Migraties draaien sowieso altijd.
# RUN_SEED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Lokaal zonder HTTPS: SESSION_SECURE_COOKIE=false.
# Productie (HTTPS): SESSION_SECURE_COOKIE=true zodat sessie-cookies alleen
# over HTTPS worden verstuurd.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Op Railway (zonder aparte queue-worker-service) 'sync' gebruiken zodat
# Filament-exports direct draaien. 'database' vereist een lopende
# `php artisan queue:work`, anders blijft een export eeuwig hangen.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis (gebracht door Laravel; op Railway zet je REDIS_URL ipv de losse host/port/username)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=redis://:password@host:6379/0

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
